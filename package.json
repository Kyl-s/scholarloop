{
  "name": "scholar-loop",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "ScholarLoop - research paper discovery, reading and writing loop",
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "build:win": "npm run build && electron-builder --win nsis --x64",
    "test": "node --test \"src/**/*.test.js\" \"server/**/*.test.js\"",
    "smoke:learning-path": "node scripts/learning-path-toggle-smoke.mjs",
    "start": "node server/index.js",
    "desktop": "electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "jose": "^6.2.12",
    "katex": "^0.18.4",
    "lucide-react": "^0.469.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.62.1",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.scholarloop.desktop",
    "productName": "ScholarLoop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "src/**/*",
      "shared/**/*",
      "assets/**/*",
      "LICENSE",
      "package.json",
      "!**/*.test.js",
      "!**/*.test.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-v2.ico",
      "artifactName": "ScholarLoop-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE"
    }
  }
}
